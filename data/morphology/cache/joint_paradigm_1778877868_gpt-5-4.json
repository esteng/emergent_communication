      "firm": "firm intensity or firm contact pressure",
      "!": "prefix meaning a new symptom has appeared mid-round",
      "x": "ineffective, no symptom change",
      "/": "prefix meaning an execution-fix delta, shorthand was right but the expansion was wrong",
      "?": "prefix meaning a request for clarification about the bit that is not understood",
      "*": "prefix meaning the following procedure is plain English and not in the shorthand table",
      "wmC": "Hold heated stone NEAR, not touching, each corner of the specified face for N seconds at the specified intensity, in sequence",
      "prC": "Press heated stone against each corner of the specified face for N seconds at the specified intensity, in sequence",
      "wmE": "Hold heated stone NEAR, not touching, each edge of the specified face for N seconds at the specified intensity, in sequence",
      "prE": "Press heated stone against each edge of the specified face for N seconds at the specified intensity, in sequence",
      "wmF": "Place or hold a warm stone NEAR the specified face for N seconds at the specified intensity",
      "S:pl": "Place warm stone beside the specified face for N seconds at the specified intensity",
      "prF": "Press stone against the specified face for N seconds at the specified intensity",
      "trE": "Trace each edge of the specified face with fingertip",
      "trC": "Trace each corner of the specified face with fingertip",
      "chC": "Chime bell once near each corner of the specified face at the specified tone intensity",
      "chE": "Chime bell near each edge of the specified face the specified number of times at the specified tone intensity",
      "chF": "Chime bell near center of the specified face once at the specified tone intensity",
      "chF_all": "Chime bell near center of each face once at the specified tone intensity, starting from the specified face",
      "drF": "Drape folded cloth over the specified face for N seconds at the specified coverage intensity",
      "drE2": "Drape cloth over 2 adjacent edges near the specified face for N seconds",
      "drAll": "Drape cool cloth over whole Veyru for N seconds",
      "fanF": "Fan the specified intensity of cool air at the specified face for N seconds",
      "fanAll": "Fan the specified intensity of cool air across all 6 faces for N seconds, starting from the specified face",
      "fanPair": "Fan the specified intensity of cool air at the specified face and the opposite face for N seconds total",
      "shF": "Shine lamp at the specified face at the specified brightness for N seconds",
